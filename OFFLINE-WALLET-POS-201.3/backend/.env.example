# ─── Primestack Payment Processor ────────────────────────────────────────────
# Base URL of your running Primestack processor
PRIMESTACK_API_URL=http://localhost:6001

# x-api-key for every request
# How to get it:
#   1. Open http://localhost:6001/admin
#   2. Login with password: Admin123
#   3. Go to "Add Merchant" tab → fill in business name + email → click Register
#   4. Copy the ps_pub_xxxx key → paste below
PRIMESTACK_API_KEY=ps_pub_REPLACE_WITH_YOUR_KEY

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=7000
JWT_SECRET=your_jwt_secret_here

# ─── npm registry token (read-only install) ───────────────────────────────────
# Generated as Granular Access Token — Read-only, "Only select packages & scopes"
#   https://www.npmjs.com/settings/YOUR_NPM_USERNAME/tokens/granular-access-tokens/new
# Consumed automatically via the project-level .npmrc file:
#   //registry.npmjs.org/:_authToken=${NPM_TOKEN}
NPM_TOKEN=replace_this_with_your_npm_token_starts_with_npm_

# Binance exchange keys (optional) — set in your local .env, do not commit real keys

# Custom crypto provider (required for live crypto buy/sell)
# CRYPTO_PROVIDER=custom
# CUSTOM_CRYPTO_PROVIDER=external
# CUSTOM_CRYPTO_API_URL=https://your-crypto-provider.example/crypto/purchase
# CUSTOM_CRYPTO_API_KEY=your_custom_api_key_here

# Bank payout provider (required for live bank payouts)
# BANK_PAYOUT_PROVIDER=external
# BANK_PAYOUT_API_URL=https://your-payout-provider.example/api/payouts
