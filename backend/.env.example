# ─────────────────────────────────────────────────────────────────────────────
# PRIMESTACK PAYMENT PROCESSOR — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=7000
JWT_SECRET=replace_with_strong_random_secret_min_64_chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password
ALLOW_LEGACY_CUSTOMER_CRYPTO_WITHDRAW_RAIL=1

# ─── EMV Issuer Cryptography (REQUIRED) ───────────────────────────────────────
# 24 bytes (48 hex chars) of DES key material. Every ARQC/ARPC is derived from it:
#   IMK -> UDK (PAN||PSN) -> session key (ATC) -> ISO 9797-1 Alg 3 retail MAC
# The EMV path fails closed without it: no cryptogram means no approval, so all
# chip transactions are declined until this is set.
EMV_ISSUER_MASTER_KEY_HEX=replace_with_48_hex_chars_of_random_key_material
# software = in-process 3DES provider (certification/sandbox only). Use
# thales | utimaco when a real HSM is wired up.
HSM_VENDOR=software

# ─── PAN Encryption / Tokenization ────────────────────────────────────────────
# CARD_ENC_KEY must be exactly 32 UTF-8 bytes (AES-256-CBC, card tokenization).
CARD_ENC_KEY=replace_with_exactly_32_utf8_bytes
# PAN_ENCRYPTION_SECRET: AES-256-GCM key for stored PANs. NEVER change it once
# cards have been issued — rotating it makes every stored PAN unreadable.
PAN_ENCRYPTION_SECRET=replace_with_strong_random_secret

# ─── Processor Identity ───────────────────────────────────────────────────────
PROCESSOR_NAME=PRIMESTACK PAYMENT PROCESSOR
PROCESSOR_HOST=http://localhost:7000
PROCESSOR_MODEL=PRIMESTACK-POS-201.3
PROCESSOR_VERSION=2.1.3
PROCESSOR_IP=your_server_public_ip
PROCESSOR_IMEI=replace_with_generated_imei
PROCESSOR_IMSI=replace_with_generated_imsi
PROCESSOR_ACTIVATION_CODE=ACT-XXXXXX-XXXXXX-XXXXXX-XXXXXX
PROCESSOR_KEY_ID=PRIMESTACK-XXXXXXXXXXXX

# ─── Processor Network Configuration ─────────────────────────────────────────
PROCESSOR_MODE=online
PROCESSOR_TCP_HOST=127.0.0.1
PROCESSOR_TCP_PORT=8583
PROCESSOR_TIMEOUT_MS=8000
PROCESSOR_API_KEY=PSPK-replace_with_generated_processor_api_key
PROCESSOR_SECRET_KEY=PSSK-replace_with_generated_processor_secret_key
PROCESSOR_MERCHANT_ID=MRC-1001
PROCESSOR_TERMINAL_ID=T2013-001
PROCESSOR_PROTOCOL=201.3
PROCESSOR_FLOOR_LIMIT=150000
DEFAULT_TID=T2013-001
MCC=5999

# Comma-separated HTTPS hostnames permitted for customer-wallet provider calls.
# Example: CUSTOMER_WALLET_PROVIDER_ALLOWED_HOSTS=payments.example.com
CUSTOMER_WALLET_PROVIDER_ALLOWED_HOSTS=

# Provider endpoint used by the CUSTOMER PORTAL C2M pull (Customer → Merchant).
# Server-configured on purpose: customers supply only their API key + secret, so
# they can never redirect the debit at an arbitrary host. Blank disables C2M.
# Example: CUSTOMER_WALLET_PROVIDER_URL=https://provider.example.com/v1/pull
CUSTOMER_WALLET_PROVIDER_URL=

# ─── Admin Credentials ────────────────────────────────────────────────────────
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=replace_with_strong_password

# ─── Operator Card — USD ──────────────────────────────────────────────────────
OPERATOR_CARD_USD_HOLDER=AJI ALOSIOUS
OPERATOR_CARD_USD_NUMBER=replace_with_luhn_valid_visa_pan
OPERATOR_CARD_USD_EXPIRY=05/30
OPERATOR_CARD_USD_CVV=replace_with_cvv
OPERATOR_CARD_USD_SCHEME=VISA
OPERATOR_CARD_USD_CURRENCY=USD

# ─── Operator Card — EUR ──────────────────────────────────────────────────────
OPERATOR_CARD_EUR_HOLDER=DANIA ALOSIOUS
OPERATOR_CARD_EUR_NUMBER=replace_with_luhn_valid_visa_pan
OPERATOR_CARD_EUR_EXPIRY=06/29
OPERATOR_CARD_EUR_CVV=replace_with_cvv
OPERATOR_CARD_EUR_SCHEME=VISA
OPERATOR_CARD_EUR_CURRENCY=EUR

# ─── Vault Bank Card Details ──────────────────────────────────────────────────
VAULT_CARD_PAN=replace_with_usd_card_pan
VAULT_CARD_CVV=replace_with_usd_cvv
VAULT_CARD_EXPIRY=05/30
VAULT_CARDHOLDER_NAME=AJI ALOSIOUS
VAULT_EUR_CARD_PAN=replace_with_eur_card_pan
VAULT_EUR_CARD_CVV=replace_with_eur_cvv
VAULT_EUR_CARD_EXPIRY=06/29
VAULT_EUR_CARDHOLDER_NAME=DANIA ALOSIOUS

# ─── Private Vault Bank Authentication ───────────────────────────────────────
VAULT_BANK_PORT=9001
VAULT_BANK_BIND_HOST=127.0.0.1
VAULT_BANK_API_KEY=replace_with_vault_bank_api_key
VAULT_BANK_SECRET_KEY=replace_with_vault_bank_secret_key
VAULT_BANK_TRANSFER_URL=http://127.0.0.1:9001/api/vault/settlement
VAULT_ACTIVE_API_KEY=replace_with_active_api_key
VAULT_BANK_WEBHOOK_SECRET=replace_with_webhook_secret

# ─── Bank Partner payout integration ──────────────────────────────────────────
BANK_PARTNER_API_URL=http://127.0.0.1:9100
BANK_PARTNER_API_KEY=
BANK_PARTNER_SECRET=

# ─── Vault Card External Load ─────────────────────────────────────────────────
VAULT_EXTERNAL_LOAD_HMAC_SECRET=replace_with_hmac_secret
VAULT_EXTERNAL_LOAD_ALLOWED_HOSTS=

# ─── Operator-Confirmed Loading Rails ─────────────────────────────────────────
# Shared operator code for the rails that credit a card without an external
# debit to verify against: bank-wire confirmation (phase 2), cash deposit, and
# loading a card from an EXTERNAL source. These rails FAIL CLOSED — if this
# value is not set the rails are unavailable and every attempt is rejected with
# CHANNEL_UNAVAILABLE. There is no default and no bypass.
VAULT_CASH_OPERATOR_CODE=replace_with_operator_confirmation_code

# ─── Acquirer Connection ─────────────────────────────────────────────────────
# HTTP-JSON mode: point at the POS API's /api/vault/card/* endpoints
# (vault.router.ts). IMPORTANT: host MUST start with https:// (or http://) —
# bare hostnames force the raw TCP ISO8583 client which cannot connect to
# HTTPS ports.
ACQUIRER_HOST=https://merchant-pos-0nno.onrender.com
ACQUIRER_PORT=443
ACQUIRER_PROTOCOL=http-json
ACQUIRER_API_KEY=
ACQUIRER_TIMEOUT_MS=8000
ACQUIRER_MERCHANT_ACCOUNT=MRC-1001
# TCP ISO8583 mode (legacy, do not use with HTTPS hosts):
ACQUIRER_TLS_CERT=
ACQUIRER_TLS_KEY=
ACQUIRER_TLS_CA=
ACQUIRER_MAC_KEY=
ACQUIRER_PIN_KEY=

# Licensed PSP / acquirer REST API — the only transport that collects real funds.
# When PSP_BASE_URL is set it replaces the vault-bank pipe for both the
# authorize (101.x) and capture (201.3) legs. Leave blank to keep the vault pipe.
PSP_BASE_URL=
PSP_API_KEY=

# Self-approval fallback — MUST be false/unset in production.
# When true, failed acquirer calls still approve the charge (test/demo only).
ALLOW_SELF_APPROVAL=false

# Operator card balances are NEVER seeded. An operator card only holds real
# money, funded through a verified rail (bank wire, USDT on-chain,
# on-ramp, gateway checkout). There is no startup seeding path.

# Online activation requires explicit provider-issued certification identifiers.
PROCESSOR_ACTIVATED=false
PROCESSOR_SPONSOR_ICA=
PROCESSOR_PID=
PROCESSOR_HOST_CERTIFICATION_ID=
EMV_L2_CERTIFICATION_ID=

# ─── Issuer / HMAC Approval Code Engine ──────────────────────────────────────
ISSUER_SECRET_KEY=PRIMESTACK-ISSUER-KEY-replace_with_strong_secret
API_KEYS=replace_with_processor_api_key

# ─── Merchant Bank Payout Provider ───────────────────────────────────────────
BANK_PAYOUT_PROVIDER=internal
# Bank rail downstream: iso8583 or dwolla (blank = internal acquirer only)
INTERNAL_PAYOUT_DOWNSTREAM=

# ─── Treasury Provider (Funds Auto Verifier + Statements/Reports) ────────────
# One generic provider used by every treasury engine. Set all three and the
# engines WILL call the provider with a signed HTTPS request — there is no
# dry-run and no silent local fallback. Leave any blank and the engines fail
# closed with PROVIDER_NOT_CONFIGURED (no funds are ever marked "verified"
# unless the provider confirms them).
PROVIDER_ENDPOINT_URL=
PROVIDER_API_KEY=
PROVIDER_SECRET_KEY=
# hmac (X-Provider-Key + X-Provider-Signature) | bearer (Authorization: Bearer)
PROVIDER_AUTH_SCHEME=hmac
# sha256 | sha512  — HMAC algorithm used to sign the request body
PROVIDER_SIGNATURE_ALGORITHM=sha512
PROVIDER_TIMEOUT_MS=20000
# Allow plain http:// (localhost is always allowed for local development)
PROVIDER_ALLOW_INSECURE_HTTP=false
# Provider contract paths (override if your provider uses different routes)
PROVIDER_PATH_FUNDS_VERIFY=/funds/verify
PROVIDER_PATH_BANK_STATEMENTS=/bank/statements
PROVIDER_PATH_RESERVE_REPORT=/reports/reserve
PROVIDER_PATH_SETTLEMENT_REPORT=/reports/settlement
PROVIDER_PATH_ACCOUNT_STATEMENT=/accounts/{accountId}/statement

# ─── Global Server (REAL FUNDS — fund-holding server) ────────────────────────
# The licensed server that actually holds the funds behind a card capture.
# After a capture confirms the sale, the ledger credit is only a claim; this
# is the call that moves REAL value:
#   1. POST {GLOBAL_SERVER_URL}/balance  { cardRef }            -> availableMinor
#   2. POST {GLOBAL_SERVER_URL}/settle   { cardRef, amountMinor, currency,
#                                          authCode, receiverBank, reference }
#      -> { status: 'CONFIRMED', settlementId, settledMinor, valueDate }
# Requests are signed with HMAC over the exact JSON body
# (headers: X-API-KEY, X-SIGNATURE). Leave any blank and the system refuses to
# call out (no settlement is ever recorded without a CONFIRMED response).
GLOBAL_SERVER_URL=
GLOBAL_API_KEY=
GLOBAL_API_SECRET=

# ─── PAYOUT DESTINATION BANK (blank until a new bank account is configured) ──
PAYOUT_BANK_NAME=
PAYOUT_BANK_ROUTING_NUMBER=
PAYOUT_BANK_ACCOUNT_NUMBER=
PAYOUT_BANK_ACCOUNT_HOLDER=
PAYOUT_BANK_ADDRESS=
PAYOUT_BANK_SWIFT=
# Optional HTTP endpoint for a bank-partner payout API (blank = not configured)
PAYOUT_BANK_API_URL=

# ─── Binance Exchange Keys ────────────────────────────────────────────────────
BINANCE_MODE=live
BINANCE_BASE_URL=https://api.binance.com
BINANCE_API_KEY=replace_with_binance_api_key
BINANCE_API_SECRET=replace_with_binance_api_secret

# ─── Exchange / Crypto Provider Selection ────────────────────────────────────
EXCHANGE_PROVIDER_PRIORITY=binance,transak,tronweb,bscweb,polygonweb,kucoin

# ─── Solana Jupiter V6 DEX Aggregator ────────────────────────────────────────
JUPITER_MODE=live
JUPITER_FORCE_LIVE=1
JUPITER_API_KEY=replace_with_jupiter_api_key
JUPITER_BASE_URL=https://quote-api.jup.ag/v6
JUPITER_PRICE_URL=https://quote-api.jup.ag/v6/price
JUPITER_QUOTE_URL=https://quote-api.jup.ag/v6/quote
JUPITER_SWAP_URL=https://quote-api.jup.ag/v6/swap
JUPITER_AUTH_HEADER=Bearer

# ─── KuCoin Exchange Keys ─────────────────────────────────────────────────────
KUCOIN_MODE=live
# KUCOIN_API_KEY=
# KUCOIN_API_SECRET=
# KUCOIN_API_PASSPHRASE=
# KUCOIN_BASE_URL=https://api.kucoin.com

# ─── Direct Blockchain Rails ─────────────────────────────────────────────────
TRON_PRIVATE_KEY=replace_with_tron_private_key_no_0x
TRON_WALLET_ADDRESS=replace_with_tron_wallet_address
TRON_API_KEY=replace_with_trongrid_api_key
TRON_JWT_SECRET=replace_with_trongrid_jwt_secret
TRON_FULL_NODE=https://api.trongrid.io

# BSC (BEP-20 USDT)
# BSC_PRIVATE_KEY=0x_your_key
# BSC_WALLET_ADDRESS=0x_your_address
# BSC_RPC_URL=https://bsc-dataseed.binance.org

# Polygon (ERC-20 USDT)
# POLYGON_PRIVATE_KEY=0x_your_key
# POLYGON_WALLET_ADDRESS=0x_your_address
# POLYGON_RPC_URL=https://polygon-rpc.com

# ─── Transak Fiat On/Off-Ramp ─────────────────────────────────────────────────
TRANSAK_DEMO_MODE=false
TRANSAK_MODE=production
TRANSAK_API_KEY=replace_with_transak_api_key
TRANSAK_API_SECRET=replace_with_transak_api_secret
TRANSAK_BASE_URL=https://api-gateway.transak.com
TRANSAK_PUBLIC_API_URL=https://api.transak.com
TRANSAK_WIDGET_URL=https://global.transak.com
TRANSAK_REFERRER_DOMAIN=your-domain.com
TRANSAK_WEBHOOK_SECRET=replace_with_transak_webhook_secret

# ─── Receiving Details Shown To The Loader ────────────────────────────────────
# The vault's own receiving destinations, printed on the "sending & receiving
# details" window for each loading rail. Bank-transfer rails are filled from the
# merchant's own rows in `bank_accounts`; these vars cover the rails that have no
# bank account row. Leave one empty and its rail shows a note saying what to set.
VAULT_USDT_TRON_ADDRESS=
VAULT_USDT_ETHEREUM_ADDRESS=
VAULT_USDT_BSC_ADDRESS=
VAULT_USDT_POLYGON_ADDRESS=
VAULT_TRANSAK_WALLET_ADDRESS=
VAULT_CASH_BRANCH=

# ─── Payment Gateways (load a vault card directly from a gateway checkout) ────
# Each gateway is offered in the UI only when all of its required vars are set.
# Webhooks are a trigger only — every credit is confirmed with the gateway API.
# Leave a gateway's vars empty to hide that rail.
#
# Public base URL the payer is redirected back to (also the webhook host root).
PUBLIC_APP_URL=https://your-domain.com

# Paystack  (NGN, GHS, ZAR, KES, USD) — webhook: HMAC-SHA512 of raw body
PAYSTACK_SECRET_KEY=
# Flutterwave  (NGN, GHS, ZAR, KES, USD, EUR, GBP) — webhook: static verif-hash
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Razorpay  (INR) — webhook: HMAC-SHA256 of raw body
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Xendit  (IDR, PHP, USD) — webhook: static x-callback-token
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Stripe  (USD, EUR, GBP, AED, AUD, CAD, SGD, CHF, JPY) — webhook: HMAC-SHA256 "t.body"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal  (USD, EUR, GBP, AUD, CAD, SGD) — webhook confirmed via PayPal API
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.paypal.com
# Shift4  (USD, EUR, GBP) — webhook: HMAC-SHA256 of raw body
SHIFT4_SECRET_KEY=
SHIFT4_WEBHOOK_SECRET=
# Paysafe / ZinaPay / ABSA — add API docs to enable (currently reported unavailable)
PAYSAFE_API_KEY=
ZINAPAY_API_KEY=
ABSA_API_KEY=

# ─── npm registry token ────────────────────────────────────────────────────────
NPM_TOKEN=replace_with_your_npm_token

# ─── Display Branding ─────────────────────────────────────────────────────────
POS_BRAND_NAME=PRIMESTACK
VAULT_DISPLAY_NAME=VAULT BANK

# ─── Key Endpoints Reference (not loaded by app — for documentation only) ─────
# POST /auth/login                              → get JWT token
# POST /merchant/v1/payments/charge             → collect payment
# POST /api/vault/vault-bank/deposits           → record incoming funds
# POST /api/vault/card-load                     → load funds to operator card
# GET  /api/vault/vault-bank/balance/:accountId → vault balance
# GET  /api/vault/card-loads                    → card load history
# POST /api/approval-code/generate              → generate HMAC approval code
# POST /api/approval-code/validate              → validate approval code
# GET  /api/vault/bank-credentials              → view bank credentials (masked)
# GET  /api/vault/bank-credentials/reveal       → view bank credentials (full)
# POST /api/vault/bank-credentials/update       → update credentials
# POST /api/vault/bank-credentials/rotate-api-key → rotate vault API key
# GET  /api/processor/identity                  → processor identity
# GET  /api/processor/terminals                 → terminal list
# POST /api/processor/terminals/register        → register terminal
# POST /api/processor/terminals/:id/activate    → activate terminal