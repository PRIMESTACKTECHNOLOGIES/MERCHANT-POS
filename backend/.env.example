# ─── App ──────────────────────────────────────────────────────────────────────
PORT=7000
JWT_SECRET=your_jwt_secret_here

# ─── Display branding (does not change transaction IDs or protocol/database identifiers) ───
POS_BRAND_NAME=PRIME
VAULT_DISPLAY_NAME=ICICI

# ─── npm registry token (read-only install) ───────────────────────────────────
# Created as Granular Access Token — Read-only, "Only select packages & scopes"
# Token name: primestack-pos-offline-backend-server
# Generate here (login as npm user first):
#   https://www.npmjs.com/settings/YOUR_NPM_USERNAME/tokens/granular-access-tokens/new
NPM_TOKEN=replace_this_with_your_npm_token_starts_with_npm_

# ─── Exchange / Crypto Provider Selection ────────────────────────────────────
# Provider priority — comma-separated, ordered from highest to lowest priority.
# Direct blockchain rails (tronweb, bscweb, polygonweb) ALWAYS outperform exchanges
# for USDT payouts because they have 0 Travel Rule, 0 KYC, 0 exchange involvement.
# For swap/buy operations the exchange order below (kucoin before binance) is
# recommended since KuCoin has minimal KYC friction.
#
# RECOMMENDED PRODUCTION SETTING (default if unset):
#   EXCHANGE_PROVIDER_PRIORITY=tronweb,bscweb,polygonweb,kucoin,binance
EXCHANGE_PROVIDER_PRIORITY=tronweb,bscweb,polygonweb,kucoin,binance

# Legacy alias (also accepted):
# CRYPTO_PROVIDER_PRIORITY=tronweb,bscweb,polygonweb,kucoin,binance

# Single-provider shorthand (lowest precedence — only used when the comma list
# above and legacy priority alias are both absent):
# CRYPTO_PROVIDER=kucoin

# ─── Binance Exchange Keys ───────────────────────────────────────────────────
# HOW TO ROTATE / CHANGE BINANCE KEYS:
#   1. Login to Binance → API Management → Create a new API key.
#   2. Enable "Enable Spot & Margin Trading" (for buy/sell swaps).
#   3. Enable "Enable Withdrawals" ONLY IF the key MUST perform on-chain
#      withdrawals (generally NOT needed — direct blockchain rails below bypass
#      Binance withdrawals entirely, so the safer default is to leave
#      Withdrawals DISABLED on the key and keep it for trading only).
#   4. Restrict the IP whitelist to your POS server(s).
#   5. Replace the three values below; delete the old key from Binance when the
#      new one is verified live.
# ─── KuCoin Exchange Keys (Primary Alternative to Binance) ────────────────────
# KuCoin has SIGNIFICANTLY LOWER KYC friction than Binance for API users.
# Setup: https://www.kucoin.com/account/api
#   - Create an API key with "General" scope (for trading + price) and
#     "Withdrawal" scope ONLY IF you will use KuCoin withdrawal endpoints
#     (recommended: use direct blockchain rails below instead; keep KuCoin
#     withdrawal permission DISABLED on the key to reduce risk surface).
#   - Record the API Secret (shown ONCE at creation) and the Passphrase you set.
#
# KUCOIN_MODE=live             # live | mock
# KUCOIN_USE_MOCK=0            # 1 = force mock
# KUCOIN_API_KEY=your_kucoin_api_key_here
# KUCOIN_API_SECRET=your_kucoin_api_secret_here
# KUCOIN_API_PASSPHRASE=your_kucoin_api_passphrase_here
# KUCOIN_BASE_URL=https://api.kucoin.com

# ─── Direct Blockchain Rails — 0 KYC / 0 Travel Rule / 0 Exchange ────────────
# These are the RECOMMENDED payout rails. Fund the hot wallets and they will
# ALWAYS bypass any exchange-level KYC / Travel Rule procedure entirely.
#
# ── TRON (TRC-20 USDT) ───────────────────────────────────────────────────────
#   - Fund address with ~25 TRX for gas (20 TRX minimum enforced by code).
#   - Fund address with USDT TRC-20 for liquidity.
# TRON_PRIVATE_KEY=your_hot_wallet_private_key_without_0x_prefix
# TRON_WALLET_ADDRESS=TFZXzaXXgk3uCcCWbUWKZAydsc95D8GZBP
# TRON_API_KEY=optional_trongrid_api_key_here
# TRON_FULL_NODE=https://api.trongrid.io

# ── BSC (Binance Smart Chain — BEP-20 USDT) ──────────────────────────────────
#   - Fund address with ~0.01 BNB for gas (0.002 BNB minimum enforced by code).
#   - Fund address with USDT BEP-20 for liquidity.
#     Contract: 0x55d398326f99059fF775485246999027B3197955
# BSC_PRIVATE_KEY=0x_your_hot_wallet_private_key_with_0x_prefix
# BSC_WALLET_ADDRESS=0x_your_hot_wallet_evm_address
# BSC_RPC_URL=https://bsc-dataseed.binance.org

# ── Polygon (ERC-20 USDT on Polygon) ─────────────────────────────────────────
#   - Fund address with ~1 MATIC for gas (0.5 MATIC minimum enforced by code).
#   - Fund address with USDT Polygon ERC-20 for liquidity.
#     Contract: 0xc2132D05D31c914a87C6611C10748AEb04B58e8F
# POLYGON_PRIVATE_KEY=0x_your_hot_wallet_private_key_with_0x_prefix
# POLYGON_WALLET_ADDRESS=0x_your_hot_wallet_evm_address
# POLYGON_RPC_URL=https://polygon-rpc.com

# Custom crypto provider (optional legacy hook)
# CUSTOM_CRYPTO_PROVIDER=external
# CUSTOM_CRYPTO_API_URL=https://your-crypto-provider.example/crypto/purchase
# CUSTOM_CRYPTO_API_KEY=your_custom_api_key_here

# ─── Bank Payout Provider ─────────────────────────────────────────────────────
# Option A — Internal acquirer:
# BANK_PAYOUT_PROVIDER=internal
# Use Wise as the transport rail:
# INTERNAL_PAYOUT_DOWNSTREAM=wise
# WISE_API_KEY=your_wise_api_key_here
# Or call your bank/processor directly from the internal acquirer:
# INTERNAL_PAYOUT_RECEIVER_URL=https://your-bank-or-processor.example/api/payouts
# INTERNAL_PAYOUT_RECEIVER_API_KEY=your_receiver_api_key_here
# Vault-bank gateway credentials are inserted into vault_api_keys at startup.
# Banks sign `${timestamp}.${nonce}.${JSON.stringify(body)}` with HMAC-SHA512.
# VAULT_BANK_API_KEY=generate_a-512-bit-key-and-store-in-your-secret-manager
# VAULT_BANK_SECRET_KEY=generate-a-512-bit-secret-and-store-in-your-secret-manager
# Optional mTLS listener for banks. Keep certificate files outside Git.
# VAULT_MTLS_ENABLED=false
# VAULT_MTLS_PORT=9443
# VAULT_MTLS_CERT_DIR=./certs
# VAULT_MTLS_CA_PATH=./certs/ca.crt
# VAULT_MTLS_CERT_PATH=./certs/vault-server.crt
# VAULT_MTLS_KEY_PATH=./certs/vault-server.key
# Replacement provider through the generic external adapter:
# BANK_PAYOUT_PROVIDER=external
# BANK_PAYOUT_API_URL=https://your-payout-provider.example/api/payouts
# BANK_PAYOUT_API_KEY=your_provider_api_key_here
# BANK_PAYOUT_API_KEY=your_provider_api_key_here
# Every new POST /api/payout/merchant/:merchantId/payout/bank calls the configured provider.

# ─── Card Processor (for wallet card topups) ─────────────────────────────────
# CARD_PROCESSOR_URL=https://your-card-processor.example/api/auth
# CARD_PROCESSOR_AUTH_URL=https://your-card-processor.example/api/auth

# ─── Licensed Acquirer (HTTP JSON) ────────────────────────────────────────────
# Required for real card authorization/capture. Do not use a placeholder URL.
# ACQUIRER_HOST=https://your-licensed-acquirer.example
# ACQUIRER_PORT=
# ACQUIRER_API_KEY=
# ACQUIRER_MERCHANT_ACCOUNT=
# ACQUIRER_TERMINAL_ID=TERM0001
# ACQUIRER_TIMEOUT_MS=8000
# ACQUIRER_PROTOCOL=http-json
# ACQUIRER_MAC_KEY=

# ─── Transak Fiat On/Off-Ramp (Primary Fiat Rail) ────────────────────────────
# Transak provides bank/card -> crypto on-ramp and crypto -> fiat off-ramp.
# Staging environment:
#   Widget:  https://global-stg.transak.com
#   API:     https://api-gateway-stg.transak.com
# Production environment:
#   Widget:  https://global.transak.com
#   API:     https://api.transak.com
#
# Setup:
#   1. Sign up at https://partners.transak.com to get Partner API credentials
#   2. API Key is public (embedded in widget URLs)
#   3. API Secret is server-side ONLY — never expose to client/browser
#   4. Whitelist your referrerDomain in Transak Partner Settings
#   5. Set up Webhook URL in Partner Settings -> Webhooks to receive order events
#      POST https://yourdomain.com/webhooks/transak
#      The backend verifies the HMAC signature with TRANSAK_WEBHOOK_SECRET.
#
# TRANSAK_MODE=staging                    # staging | production
# TRANSAK_USE_MOCK=0                      # 1 = force mock mode
# TRANSAK_API_KEY=replace_with_transak_partner_api_key
# TRANSAK_API_SECRET=replace_with_transak_partner_api_secret
# TRANSAK_BASE_URL=https://api-gateway-stg.transak.com
# TRANSAK_PUBLIC_API_URL=https://api-stg.transak.com
# TRANSAK_WIDGET_URL=https://global-stg.transak.com
# TRANSAK_REFERRER_DOMAIN=yourdomain.com
# TRANSAK_WEBHOOK_SECRET=replace_with_transak_webhook_signing_secret
#
# Controlled Vault safety limit:
# VAULT_MAX_PAYOUT_AMOUNT=0       # 0 disables the amount limit
#
# Virtual Account Payments:
#   Enable Virtual Account Payments in the Transak Partner Dashboard.
#   These endpoints require production mode and use the same API key:
#     POST /bank-transfer/create-account
#     GET  /bank-transfer/:transactionId
#   Configure the payment webhook URL in Transak as:
#     POST https://yourdomain.com/api/bank-transfer/webhook
#   The webhook must be routed through the same signature-verification policy
#   and should only mark a transaction received/completed after verification.
#   The local implementation currently requires:
#     TRANSAK_MODE=production
#   Optional separate keys are supported by the bank-transfer service:
# TRANSAK_API_KEY_PROD=replace_with_production_partner_api_key
# TRANSAK_API_KEY_STG=replace_with_staging_partner_api_key

TRANSAK_MODE=production
TRANSAK_BASE_URL=https://api-gateway.transak.com
TRANSAK_PUBLIC_API_URL=https://api.transak.com
TRANSAK_WIDGET_URL=https://global.transak.com
