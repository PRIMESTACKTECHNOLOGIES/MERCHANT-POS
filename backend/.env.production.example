# Example production environment variables for Backend (no secrets here)
# Copy this to backend/.env in local development or set real values in your deployment provider

# App
PORT=7000
JWT_SECRET=replace_with_secure_random_hex_here

# Crypto provider (optional)
# CRYPTO_PROVIDER=binance

# Bank payout provider (wise or external)
# BANK_PAYOUT_PROVIDER=wise
# WISE_API_URL=https://api.transferwise.com
# WISE_API_KEY=
# WISE_PROFILE_ID=

# Custom crypto provider
# CUSTOM_CRYPTO_PROVIDER=external
# CUSTOM_CRYPTO_API_URL=
# CUSTOM_CRYPTO_API_KEY=

# External payout provider
# BANK_PAYOUT_API_URL=
# BANK_PAYOUT_API_KEY=
PORT=7000
JWT_SECRET=replace_with_a_long_random_secret
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
DATABASE_URL=./data/pos_offline.sqlite
CUSTOM_CRYPTO_PROVIDER=external
CUSTOM_CRYPTO_API_URL=https://your-crypto-provider.example/crypto/purchase
CUSTOM_CRYPTO_API_KEY=your_custom_api_key_here

# ─── Bank Payout Provider ─────────────────────────────────────────────────────
# Option A — Native Wise (TransferWise): 4-step flow (recipient → quote → transfer → fund)
#   Uncomment these lines and set BANK_PAYOUT_PROVIDER=wise
# BANK_PAYOUT_PROVIDER=wise
# WISE_API_URL=https://api.transferwise.com
# WISE_API_KEY=020fe12f-2882-4a22-9235-669e96d8f576
# WISE_PROFILE_ID=your_wise_numeric_profile_id

# Option B — Custom proxy provider: POST your own payout API
# BANK_PAYOUT_PROVIDER=external
# BANK_PAYOUT_API_URL=https://your-payout-provider.example/api/payouts
# BANK_PAYOUT_API_KEY=your_provider_api_key_here
