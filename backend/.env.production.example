# Production environment variables — copy to backend/.env and fill real values

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=7000
JWT_SECRET=replace_with_secure_random_hex_here
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=./data/pos_offline.sqlite

# Licensed card acquirer (HTTP JSON). Keep credentials in the deployment secret store.
# ACQUIRER_HOST=https://your-licensed-acquirer.example
# ACQUIRER_API_KEY=
# ACQUIRER_MERCHANT_ACCOUNT=
# ACQUIRER_TERMINAL_ID=TERM0001
# ACQUIRER_TIMEOUT_MS=8000
# ACQUIRER_PROTOCOL=http-json
# ACQUIRER_MAC_KEY=

# ─── Bank Payout Provider ─────────────────────────────────────────────────────
# "manual"   = operator confirms receipt manually (default)
# "external" = system auto-POSTs to your licensed processor endpoint
BANK_PAYOUT_PROVIDER=manual

# Internal vault-bank gateway (required when BANK_PAYOUT_PROVIDER=internal)
# VAULT_BANK_API_KEY=store-in-deployment-secret-manager
# VAULT_BANK_SECRET_KEY=store-in-deployment-secret-manager
# VAULT_MTLS_ENABLED=true
# VAULT_MTLS_PORT=9443
# VAULT_MTLS_CERT_DIR=./certs
# VAULT_MTLS_CA_PATH=./certs/ca.crt
# VAULT_MTLS_CERT_PATH=./certs/vault-server.crt
# VAULT_MTLS_KEY_PATH=./certs/vault-server.key

# Uncomment and fill when you have processor credentials:
# BANK_PAYOUT_PROVIDER=external
# BANK_PAYOUT_API_URL=https://your-processor.com/api/payout
# BANK_PAYOUT_API_KEY=your_processor_api_key

# ─── Card Processor ───────────────────────────────────────────────────────────
# Uncomment and fill when ready to connect your licensed card processor:
# CARD_PROCESSOR_URL=https://your-processor.com/api/authorize
# CARD_PROCESSOR_CAPTURE_URL=https://your-processor.com/api/capture
# CARD_PROCESSOR_AUTH_HEADER=Bearer your_token
# CARD_PROCESSOR_MERCHANT_ID=MRC-1001
# CARD_PROCESSOR_ENABLED=true

# ─── Crypto / Blockchain Rails ────────────────────────────────────────────────
# TRON (TRC-20 USDT)
# TRON_PRIVATE_KEY=your_hot_wallet_private_key
# TRON_WALLET_ADDRESS=your_tron_address
# TRON_API_KEY=your_trongrid_api_key
# TRON_FULL_NODE=https://api.trongrid.io

# ─── Transak (fiat on/off-ramp) ───────────────────────────────────────────────
# TRANSAK_MODE=production
# TRANSAK_API_KEY=your_transak_api_key
# TRANSAK_API_SECRET=your_transak_api_secret
# TRANSAK_BASE_URL=https://api-gateway.transak.com
# TRANSAK_WIDGET_URL=https://global.transak.com
# TRANSAK_REFERRER_DOMAIN=yourdomain.com
# TRANSAK_WEBHOOK_SECRET=your_webhook_secret

# ─── Binance Exchange ─────────────────────────────────────────────────────────
# BINANCE_MODE=live
# BINANCE_BASE_URL=https://api.binance.com
# BINANCE_API_KEY=your_binance_api_key
# BINANCE_API_SECRET=your_binance_api_secret
