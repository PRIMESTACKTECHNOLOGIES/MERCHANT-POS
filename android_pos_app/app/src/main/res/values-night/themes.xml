<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PosApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pos_primary</item>
        <item name="colorPrimaryVariant">@color/pos_primary_container</item>
        <item name="colorOnPrimary">@color/pos_on_primary</item>
        <item name="colorSecondary">@color/pos_accent</item>
        <item name="colorSecondaryVariant">@color/pos_accent_teal</item>
        <item name="colorOnSecondary">@color/pos_on_primary</item>
        <item name="colorError">@color/pos_error</item>
        <item name="colorOnError">@color/pos_on_primary</item>
        <item name="colorSurface">@color/pos_surface</item>
        <item name="colorOnSurface">@color/pos_on_surface</item>
        <item name="android:windowBackground">@color/pos_background</item>
        <item name="android:statusBarColor">@color/pos_surface</item>
        <item name="android:navigationBarColor">@color/pos_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PosApp.MaterialAlertDialog</item>
        <item name="materialCardViewStyle">@style/Widget.PosApp.CardView</item>
        <item name="materialButtonStyle">@style/Widget.PosApp.Button</item>
        <item name="textInputStyle">@style/Widget.PosApp.TextInput</item>
        <item name="bottomNavigationStyle">@style/Widget.PosApp.BottomNav</item>
    </style>

    <style name="Theme.PosApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/pos_surface</item>
    </style>

    <style name="Theme.PosApp.TransparentStatusBar" parent="Theme.PosApp.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="ThemeOverlay.PosApp.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/pos_primary</item>
        <item name="colorSecondary">@color/pos_accent</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.PosApp.DialogTitle</item>
    </style>

    <style name="Widget.PosApp.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/pos_surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/pos_divider</item>
        <item name="strokeWidth">0.5dp</item>
    </style>

    <style name="Widget.PosApp.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/pos_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/pos_on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.PosApp.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/pos_primary</item>
        <item name="android:textColor">@color/pos_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.PosApp.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/pos_primary</item>
        <item name="hintTextColor">@color/pos_text_muted</item>
    </style>

    <style name="Widget.PosApp.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/pos_primary</item>
        <item name="itemTextColor">@color/pos_primary</item>
        <item name="background">@color/pos_bg_surface</item>
        <item name="android:background">@color/pos_bg_surface</item>
    </style>

    <style name="TextAppearance.PosApp.DialogTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/pos_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PosApp.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/pos_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PosApp.Amount" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textColor">@color/pos_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
